# === Reformer Your Body — environment ===
# Salin ke `.env` lalu isi nilai aslinya. JANGAN commit `.env`.

APP_NAME="Reformer Your Body"
ENVIRONMENT=production
DEBUG=false

# Ganti dengan string acak panjang: `openssl rand -base64 48`
SECRET_KEY=ganti-dengan-kunci-acak-panjang

# Database
POSTGRES_USER=pilates_user
POSTGRES_PASSWORD=ganti-password-kuat
POSTGRES_DB=pilates_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

TIMEZONE=Asia/Jakarta
